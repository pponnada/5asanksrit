<%- include('partials/head', { title: ui.text.reviewTitle }) %>

<main class="review-page">
  <h1><%= ui.text.reviewTitle %><% if (ui.hint.reviewTitle) { %> <span class="en"><%= ui.hint.reviewTitle %></span><% } %></h1>
  <div class="score-banner"><%= ui.text.score %> : <strong><%= score %> / <%= total %></strong></div>

  <% items.forEach(function(item, idx) { %>
    <%- include('partials/question', {
      item: item,
      questionNumber: idx + 1,
      totalQuestions: items.length,
      selectedOption: answers[item.id] || null,
      ui: ui,
      reveal: true,
      interactive: false
    }) %>
  <% }); %>

  <a class="nav-btn" href="/"><%= ui.text.home %><% if (ui.hint.home) { %> <span class="en"><%= ui.hint.home %></span><% } %></a>
</main>

<%- include('partials/foot') %>
