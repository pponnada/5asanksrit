<%- include('partials/head', { title: 'Practice' }) %>

<main class="landing">
  <h1>Practice</h1>

  <% subjects.forEach(function(subject) { %>
    <section class="subject-block">
      <h2><%= subject.name %><% if (subject.nameEn !== subject.name) { %> <span class="en">(<%= subject.nameEn %>)</span><% } %></h2>

      <% if (subject.latestPaper) { %>
        <a class="take-test-btn" href="/test/<%= subject.latestPaper.id %>"><%= subject.ui.text.takeTest %><% if (subject.ui.hint.takeTest) { %><br><span class="en"><%= subject.ui.hint.takeTest %></span><% } %></a>
      <% } else { %>
        <p class="empty-state"><%= subject.ui.text.noTest %><% if (subject.ui.hint.noTest) { %><br><span class="en"><%= subject.ui.hint.noTest %></span><% } %></p>
      <% } %>

      <% if (subject.flashcards) { %>
        <a class="flashcards-btn" href="/flashcards"><%= subject.ui.text.flashcards %><% if (subject.ui.hint.flashcards) { %><br><span class="en"><%= subject.ui.hint.flashcards %></span><% } %></a>
      <% } %>

      <% if (subject.otherPapers.length > 0) { %>
        <details class="other-papers">
          <summary><%= subject.ui.text.otherTests %><% if (subject.ui.hint.otherTests) { %> <span class="en"><%= subject.ui.hint.otherTests %></span><% } %></summary>
          <ul>
            <% subject.otherPapers.forEach(function(p) { %>
              <li>
                <a href="/test/<%= p.id %>">
                  <%= p.id %>
                  <span class="status-tag <%= p.taken ? 'taken' : 'not-taken' %>">
                    <%= p.taken ? (subject.ui.text.done + ' — ' + p.score) : subject.ui.text.notDone %>
                  </span>
                </a>
              </li>
            <% }); %>
          </ul>
        </details>
      <% } %>
    </section>
  <% }); %>
</main>

<%- include('partials/foot') %>
