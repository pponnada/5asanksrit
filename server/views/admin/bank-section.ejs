<%- include('../partials/head', { title: 'Question Bank' }) %>

<main class="admin-dashboard builder-page">
  <p><a href="/admin/bank">← All sections</a></p>
  <h1>विभागः <%= section.number %> — <%= section.title %></h1>

  <% if (section.isMeanings) { %>
    <p class="en">
      Corpus only — Meanings is never GenAI-generated. This section's bank is
      just its <%= section.nativeUsableCount %> usable native items from
      <code>qa-corpus.md</code>.
    </p>
  <% } else { %>
    <section class="generate-block">
      <h2>Bank</h2>
      <p class="en">
        <%= section.nativeUsableCount %> usable in corpus ·
        <%= section.approvedItems.length %> approved-GenAI
        (<%= section.nativeUsableCount + section.approvedItems.length %> total available for papers)
      </p>
      <% if (section.approvedItems.length) { %>
        <ul class="approved-summary">
          <% section.approvedItems.forEach(function(item) { %>
            <li><strong><%= item.id %>:</strong> <%= item.stem %> — <span class="en">Answer:</span> <%= item.answer %></li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <section class="generate-block">
      <h2>Add more questions</h2>

      <% if (!section.pending) { %>
        <form method="POST" action="/admin/bank/<%= section.number %>/start" class="paste-form">
          <label class="en" for="count">How many new questions to generate?</label>
          <input type="number" min="1" id="count" name="count" value="5">
          <button type="submit" class="primary-btn">Get prompt</button>
        </form>
      <% } else { %>
        <p class="en">
          Generating <%= section.pending.requestedCount %> new question<%= section.pending.requestedCount === 1 ? '' : 's' %>.
          <form method="POST" action="/admin/bank/<%= section.number %>/cancel" style="display:inline">
            <button type="submit" class="link-btn">Start over</button>
          </form>
        </p>

        <div class="prompt-panel">
          <textarea class="prompt-text" readonly rows="10" id="prompt-<%= section.number %>"><%= section.prompt %></textarea>
          <button type="button" class="copy-prompt-btn" data-copy-target="prompt-<%= section.number %>">Copy Prompt</button>
        </div>

        <form method="POST" action="/admin/bank/<%= section.number %>/parse" class="paste-form">
          <label class="en" for="pasted-<%= section.number %>">Paste the LLM's JSON reply here:</label>
          <textarea id="pasted-<%= section.number %>" name="pasted" rows="8"><%= section.pending.raw || '' %></textarea>
          <button type="submit" class="primary-btn">Parse</button>
        </form>

        <% if (section.pending.errors && section.pending.errors.length) { %>
          <ul class="parse-errors">
            <% section.pending.errors.forEach(function(e) { %><li><%= e %></li><% }); %>
          </ul>
        <% } %>

        <% if (section.pending.items && section.pending.items.length) { %>
          <form method="POST" action="/admin/bank/<%= section.number %>/approve" class="review-form">
            <p class="en">Review each question below, then approve or reject it.</p>
            <% section.pending.items.forEach(function(item, i) { %>
              <div class="candidate-item">
                <div class="approve-reject">
                  <label><input type="radio" name="approve_<%= i %>" value="1" checked> <span class="en">Approve</span></label>
                  <label><input type="radio" name="approve_<%= i %>" value=""> <span class="en">Reject</span></label>
                </div>
                <label class="en">Stem:
                  <input type="text" name="stem_<%= i %>" value="<%= item.stem %>">
                </label>
                <% item.options.forEach(function(opt, j) { %>
                  <label class="en">Option <%= j + 1 %>:
                    <input type="text" name="option_<%= i %>_<%= j %>" value="<%= opt %>">
                  </label>
                <% }); %>
                <label class="en">Answer:
                  <input type="text" name="answer_<%= i %>" value="<%= item.answer %>">
                </label>
                <label class="en">Note:
                  <input type="text" name="note_<%= i %>" value="<%= item.note || '' %>">
                </label>
              </div>
            <% }); %>
            <button type="submit" class="primary-btn">Save reviewed questions</button>
          </form>
        <% } %>
      <% } %>
    </section>
  <% } %>
</main>

<script src="/js/builder.js"></script>
<%- include('../partials/foot') %>
