<%- include('../partials/head', { title: 'Question Bank' }) %>

<main class="admin-dashboard builder-page">
  <h1>Question Bank — <%= subject.nameEn %></h1>
  <p class="en">
    Build up each section's pool of usable questions ahead of time. When you
    build a paper, you'll draw a count straight from what's banked here.
  </p>

  <a class="build-new-paper-btn" href="<%= base %>/builder">Create Question Paper</a>

  <ul class="section-list">
    <% sections.forEach(function(s) { %>
      <li class="section-row">
        <span class="section-title"><%= s.label %> <%= s.number %> — <%= s.title %></span>
        <span class="section-counts en">
          <%= s.nativeUsableCount %> usable in corpus · <%= s.genaiApprovedCount %> approved-GenAI
        </span>
        <% if (s.corpusOnly) { %>
          <span class="bank-locked en">Corpus only</span>
        <% } else { %>
          <a class="bank-manage-link" href="<%= base %>/bank/<%= s.number %>">Manage →</a>
        <% } %>
      </li>
    <% }); %>
  </ul>
</main>

<%- include('../partials/foot') %>
