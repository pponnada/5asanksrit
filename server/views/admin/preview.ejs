<%- include('../partials/head', { title: 'Preview — ' + paper.id }) %>

<main class="review-page">
  <h1>Preview <span class="en"><%= paper.id %></span></h1>
  <p class="preview-banner">PREVIEW — answers shown, not a live attempt.</p>
  <p class="paper-summary"><%= paper.sections.join(', ') %> · <%= paper.items.length %> questions · <%= paper.timeLimitMinutes %> min</p>

  <% if (!isLatest) { %>
    <form method="POST" action="/admin/make-latest/<%= paper.id %>" class="publish-form">
      <button type="submit" class="primary-btn">Publish — make this the Student's "Take Test" paper</button>
    </form>
  <% } else { %>
    <p class="already-latest en">This is already the Student's current "Take Test" paper.</p>
  <% } %>

  <% paper.items.forEach(function(item, idx) { %>
    <%- include('../partials/question', {
      item: item,
      questionNumber: idx + 1,
      totalQuestions: paper.items.length,
      reveal: true,
      interactive: false
    }) %>
  <% }); %>

  <a class="nav-btn" href="/admin/dashboard">← Dashboard</a>
</main>

<%- include('../partials/foot') %>
